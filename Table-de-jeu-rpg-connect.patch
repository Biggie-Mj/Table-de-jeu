+ const button=document.createElement('button');button.id='rpgMjOpen';button.type='button';button.textContent='RPG Connect';button.className='ghost';document.querySelector('.topbar')?.append(button);
+ const dlg=document.createElement('dialog');dlg.id='rpgMjDialog';dlg.className='modal rpg-mj-dialog';dlg.innerHTML=`<div class="modal-shell"><div class="modal-head"><div><span class="eyebrow">COMPAGNIE CRÉOLE</span><h2>RPG Connect</h2></div><button type="button" data-rpg-close class="icon-btn">×</button></div><p id="rpgMjStatus">Hors ligne · ENCOUNTER reste autonome.</p><div class="rpg-mj-config"><label>Serveur WebSocket <input id="rpgMjEndpoint" type="url" placeholder="wss://…"></label><label>Clé MJ du serveur <input id="rpgMjKey" type="password" autocomplete="off"></label><label>Salle <input id="rpgMjRoom" placeholder="Nouvelle salle ou code existant"></label><button type="button" id="rpgMjConnect" class="primary">Créer / rejoindre</button><button type="button" id="rpgMjDisconnect" class="ghost">Déconnecter</button></div><p class="muted tiny">La clé MJ reste en mémoire jusqu’à la fermeture de la page. Les jetons d’invitation restent dans cette session.</p><div id="rpgMjPlayers"></div><div id="rpgMjPending"></div><p id="rpgMjFeedback" role="status"></p></div>`;document.body.append(dlg);
+ const status=$r('#rpgMjStatus'),feedback=$r('#rpgMjFeedback'),endpointField=$r('#rpgMjEndpoint'),keyField=$r('#rpgMjKey'),roomField=$r('#rpgMjRoom');
+ try{let prior=JSON.parse(localStorage.getItem(savedKey)||'{}');endpointField.value=prior.endpoint||'';roomField.value=prior.room||''}catch{}
+ function note(text){feedback.textContent=text}
+ function endpoint(){let url=new URL(endpointField.value.trim());if(url.protocol!=='wss:'&&!(url.protocol==='ws:'&&['localhost','127.0.0.1','[::1]'].includes(url.hostname)))throw Error('Adresse wss:// requise (ws:// autorisé en local).');return url.href}
+ function send(m){if(socket?.readyState!==WebSocket.OPEN)return false;socket.send(JSON.stringify({v:1,...m}));return true}
+ const participant=id=>state.encounter.participants.find(p=>p.id===bindings[id]);
+ const online=id=>players.some(p=>p.characterId===id&&p.online);
+ function command(id,type,payload){if(!connected){note('Connecte la console au serveur.');return false}const event={id:uid(),type,characterId:id,timestamp:new Date().toISOString(),payload};send({type:'command',room,characterId:id,event});note(`${names[id]} · commande ${online(id)?'envoyée':'en attente de connexion'}.`);return event.id}
