 data-add-item="${id}" ${!connected?'disabled':''}>Ajouter</button></div></article>`}).join('');
+  $r('#rpgMjPending').innerHTML=[...pending.values()].map(item=>`<article class="rpg-mj-decision"><b>${names[item.characterId]} · attaque ${escape(item.event.payload?.roll??'')}</b><small>${escape(item.event.payload?.actor||item.characterId)} · ${escape(item.attackId)}</small><button data-hit="${escape(item.attackId)}" ${item.deciding?'disabled':''}>Touché</button><button data-miss="${escape(item.attackId)}" ${item.deciding?'disabled':''}>Raté</button></article>`).join('');
+ }
+ function bindState(id,value){if(!value||value.characterId!==id)return;lastStates[id]=value;const p=participant(id);if(p){let changed=p.hp!==value.hp.current||p.tempHp!==value.hp.temp||p.maxHp!==value.hp.max||p.ac!==value.ac;if(changed){p.hp=value.hp.current;p.maxHp=value.hp.max;p.tempHp=value.hp.temp;if(Number.isFinite(value.ac))p.ac=value.ac;saveState();render()}}renderPanel()}
+ function onEvent(event){if(!event?.id||!ids.includes(event.characterId))return;const id=event.characterId;if(event.type==='attack:pending-hit'){const attackId=event.payload?.attackId;if(attackId)pending.set(attackId,{attackId,characterId:id,event})}
+  if(event.type==='attack:hit'||event.type==='attack:miss'||event.type==='undo:performed')for(const [attackId,item] of pending)if(item.characterId===id&&(event.type==='undo:performed'||attackId===event.payload?.attackId))pending.delete(attackId);
+  if(event.type==='state:changed')bindState(id,event.payload?.state);
+  if(event.type==='journal:event'||event.type==='attack:rolled'||event.type==='attack:hit'||event.type==='attack:miss') {log(`RPG · ${names[id]} · ${event.type}${event.payload?.roll!=null?' · '+event.payload.roll:''}`);saveState();render()}
+  renderPanel();
+ }
+ function connect(){let url;try{url=endpoint();if(keyField.value.trim().length<24)throw Error('Clé MJ manquante ou trop courte.')}catch(error){note(error.message);return}
+  active=true;clearTimeout(retryTimer);const old=socket;if(old&&old.readyState<2)old.close();const current=new WebSocket(url);socket=current;status.textContent='Connexion…';
+  current.onopen=()=>{if(socket===current)send({type:'hello',role:'gm',room:roomField.value.trim(),key:keyField.value.trim()})};
+  current.onmessage=e=>{if(socket!==current)return;let m;try{m=JSON.parse(e.data)}catch{return}
+   if(m.type==='welcome'){room=m.room;roomField.value=room;connected=true;retry=0;status.textContent='Connecté · salle '+room;localStorage.setItem(savedKey,JSON.stringify({endpoint:endpointField.value.trim(),room}));players=m.payload?.players||[];for(const p of players)if(p.state)bindState(p.characterId,p.state);renderPanel();return}
+   if(m.type==='roster'){players=m.payload?.players||[];for(const p of players)if(p.state)bindState(p.characterId,p.state);renderPanel();return}
+   if(m.type==='invite'){invites[m.characterId]=m.payload?.token;renderPanel();return}
+   if(m.type==='state'){bindState(m.characterId,m.state);return}
+   if(m.type==='event'){onEvent(m.event);return}
+   if(m.type==='queued'){note(`${names[m.characterId]} · ${m.online?'commande remise':'commande en attente de reconnexion'}.`);return}
+   if(m.type==='command-ack'){let attackId=decisionCommands.get(m.id);if(attackId){let item=pending.get(attackId);if(m.result==='applied'||m.result==='duplicate')pending.delete(attackId);else if(item)item.deciding=false;decisionCommands.delete(m.id);renderPanel()}note(`${names[m.characterId]} · ${m.result==='applied'?'commande appliquée':m.result}.`);return}
+   if(m.type==='error'){note(m.message);if(!connected){active=false;current.close()}}
+  };
+  current.onerror=()=>note('Serveur indisponible ; ENCOUNTER reste autonome.');
+  current.onclose=()=>{if(socket!==current)return;connected=false;status.textContent=active?'Connexion interrompue · ENCOUNTER autonome':'Hors ligne · ENCOUNTER autonome';renderPanel();if(active)retryTimer=setTimeout(connect,Math.min(30000,900*2**Math.min(retry++,5)))};
+ }
+ button.onclick=()=>{renderPanel();dlg.showModal()};$r('[data-rpg-close]').onclick=()=>dlg.close();$r('#rpgMjConnect').onclick=connect;$r('#rpgMjDisconnect').onclick=()=>{active=false;connected=false;clearTimeout(retryTimer);socket?.close();status.textContent='Hors ligne · ENCOUNTER autonome';renderPanel()};
