+/* ENCOUNTER adapter: the cockpit routes commands; companions resolve their own rules. */
+(()=>{'use strict';
+ const ids=['kentaro','samoth','brackmard','rufus','nans','zephyr'];
+ const names={kentaro:'Kentaro',samoth:'Samoth',brackmard:'Brack Mard',rufus:'Rufus',nans:'Nans',zephyr:'Zéphyr'};
+ const savedKey='rpg-connect:mj:v1',bindingsKey='rpg-connect:bindings:v1';
